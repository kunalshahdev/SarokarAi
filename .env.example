# Sarokar - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit real keys. All AI keys are server-side only.

# --- Primary AI provider (required) ---
# Google Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# --- Failover AI providers (strongly recommended, all have free tiers) ---
# Tried in order after Gemini when it returns 429 / quota / outage.
# Groq API key: https://console.groq.com
GROQ_API_KEY=
# Cerebras API key: https://cloud.cerebras.ai (free tier requires billing info on the Billing tab first)
CEREBRAS_API_KEY=
# OpenRouter API key: https://openrouter.ai (use :free model ids; shared pools are often congested, so keep this last)
OPENROUTER_API_KEY=

# --- Optional model overrides ---
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=gpt-oss-120b
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Optional provider order (comma-separated) ---
# AI_PROVIDER_ORDER=gemini,groq,cerebras,openrouter

# --- Circuit breaker (stop hammering a failing provider) ---
# After N consecutive provider failures, skip it for this long.
# AI_BREAKER_THRESHOLD=3
# AI_BREAKER_COOLDOWN_MS=300000

# --- Optional daily/burst limits (per user tier) ---
# Guest tier applies to anonymous visitors (no auth yet).
# AI_GUEST_DAILY_LIMIT=15
# AI_GUEST_BURST_PER_MINUTE=8
# AI_USER_DAILY_LIMIT=20
# AI_USER_BURST_PER_MINUTE=12
# AI_PREMIUM_DAILY_LIMIT=100
# AI_PREMIUM_BURST_PER_MINUTE=30
# Secondary abuse guard per IP across chat endpoints:
# AI_IP_HOURLY_LIMIT=60

# --- Optional retry/history/tuning ---
# AI_MAX_RETRIES_PER_PROVIDER=2
# AI_RETRY_BASE_DELAY_MS=300
# AI_RETRY_MAX_DELAY_MS=1500
# AI_HISTORY_MAX_MESSAGES=12
# AI_HISTORY_MAX_CHARS=6000
# AI_UPSTREAM_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=3072

# --- Dev-only mock provider (NEVER set in production) ---
# Simulates a provider for testing fallback without burning quota:
# 1 to enable, plus a scenario: ok | rate_limit_once | always_429 | always_500
# AI_ENABLE_MOCK_PROVIDER=
# AI_MOCK_SCENARIO=ok
